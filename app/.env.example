# Optional. Leave blank to keep all media local.
# Transcription and AI only run after an explicit click in Replay.
OPENAI_API_KEY=
# Optional storage location. Use an absolute path outside the repo to keep
# recordings when replacing a downloaded copy. Copy existing data first.
# REPLAY_DATA_DIR=/absolute/path/to/ReplayData
# Optional full executable paths if FFmpeg is not on PATH.
# REPLAY_FFMPEG=/absolute/path/to/ffmpeg
# REPLAY_FFPROBE=/absolute/path/to/ffprobe
# REPLAY_FONT=/absolute/path/to/font.ttf
# REPLAY_AI_MODEL=gpt-4.1-mini
# REPLAY_SEED=false
