{
  "name": "@replay/local",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/server-integration.mjs tests/server-stitch-retry.mjs tests/lib.test.mjs tests/review.test.mjs tests/composition.test.mjs tests/motion.test.mjs tests/watch.test.mjs tests/sites-worker.test.mjs tests/theme.test.mjs tests/analytics.test.mjs tests/startup.test.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.0.8",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
